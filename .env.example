# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Backend ---
# Secret used to sign JWT tokens. Generate a long random string for real use.
JWT_SECRET=change-this-to-a-long-random-string
# How long an access token stays valid, in milliseconds (1 hour below).
JWT_EXPIRATION_MS=3600000
# Where SQLite stores the database file and where uploaded files are written.
DB_PATH=./app.db
UPLOAD_DIRECTORY=./uploads
# Max upload size (also enforced in Spring config), in MB.
MAX_FILE_SIZE_MB=10
# Origin allowed to call this API (the frontend dev server).
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Frontend ---
# Base URL the frontend uses to reach the backend REST API.
VITE_API_URL=http://localhost:8080/api
# Base URL for the WebSocket endpoint.
VITE_WS_URL=ws://localhost:8080/ws
